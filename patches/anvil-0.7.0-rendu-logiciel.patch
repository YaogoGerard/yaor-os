# anvil (Smithay 0.7.0) — accepter le rendu logiciel EGL derrière l'env
# YAOR_SOFTWARE_OK : sous QEMU sans GPU hôte accéléré (pas de virtio-gpu-gl/virgl
# côté hôte), anvil refuse un EGLDevice logiciel (NoRenderNode) et meurt à
# l'init du nœud primaire (constat QA v0.4). Deux ajustements :
#  1. l'acceptation du device logiciel (comportement amont inchangé sans la
#     variable) ;
#  2. le node de rendu retombe sur le render node du nœud primaire (les
#     devices logiciels n'exposent pas de render node EGL) — la clé demandée
#     par single_renderer/primary_gpu (renderD128) devient trouvable.
--- sm-test3/smithay-0.7.0/anvil/src/udev.rs	2025-06-24 19:04:19.000000000 +0000
+++ new3/anvil/src/udev.rs	2026-10-22 13:45:30.190107782 +0000
@@ -784,10 +784,21 @@
             let egl_device = EGLDevice::device_for_display(&display).map_err(DeviceAddError::AddNode)?;
 
             if egl_device.is_software() {
-                return Err(DeviceAddError::NoRenderNode);
+                if std::env::var("YAOR_SOFTWARE_OK").is_err() {
+                    return Err(DeviceAddError::NoRenderNode);
+                }
+                warn!("rendu logiciel accepté (YAOR_SOFTWARE_OK) — pas de GPU hôte");
             }
 
-            let render_node = egl_device.try_get_render_node().ok().flatten().unwrap_or(node);
+            // YAOR (rendu logiciel) : pas de render node exposé par le device
+            // logiciel ; on retombe sur le render node du nœud primaire (clé
+            // exigée par single_renderer, cf. primary_gpu côté anvil).
+            let render_node = egl_device
+                .try_get_render_node()
+                .ok()
+                .flatten()
+                .or_else(|| node.node_with_type(NodeType::Render).and_then(|x| x.ok()))
+                .unwrap_or(node);
             self.backend_data
                 .gpus
                 .as_mut()
