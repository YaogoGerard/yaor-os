# YAOR — transfert de la racine (slots A/B, ADR-015, REQ-SW-020).
#
# systemd-sysupdate écrit l'image du système dans l'une des deux partitions
# « root-x86-64 » (les slots A/B créés par /etc/repart.d) : la partition libre
# (étiquette « _empty ») est remplie, puis réétiquetée « yaor-root_<v> » où
# « <v> » est la version de l'image. Deux versions coexistent au plus
# (InstancesMax=2) ; `yaor-slot` choisit celle que Limine démarre.
#
# Source « url-file » : l'étape 03 télécharge le manifeste « SHA256SUMS »
# (à terme sa signature « SHA256SUMS.asc ») sous « Path », puis l'image
# listée ; sysupdate télécharge lui-même « SHA256SUMS » et valide la somme.
[Transfer]
# Vérification de l'image téléchargée : le digest SHA-256 de l'artefact (lu
# dans « SHA256SUMS ») est TOUJOURS vérifié par (sd-pull), quelle que soit
# cette directive. « Verify=no » la limite à cette vérification : sa valeur
# par défaut (true) réclamerait en plus la signature « SHA256SUMS.asc » du
# manifeste, indisponible sans fournisseur GPG (point ouvert ADR-007).
Verify=no
# Protection de la version en cours : « %A » se développe en « IMAGE_VERSION= »
# d'/etc/os-release. La version protégée n'est jamais écrasée, ce qui évite de
# corrompre la racine en cours d'exécution. Prérequis : définir IMAGE_VERSION=
# dans /etc/os-release (voir le LLD, « points ouverts »).
ProtectVersion=%A

[Source]
Type=url-file
Path=https://updates.yaor.example/root/
MatchPattern=yaor-root_x86-64_@v.raw.xz

[Target]
Type=partition
Path=auto
MatchPartitionType=root-x86-64
MatchPattern=yaor-root_@v
# Les slots sont marqués « NoAuto » et « ReadOnly » (mêmes attributs que dans
# /etc/repart.d) ; systemd-sysupdate les applique à l'écriture.
PartitionNoAuto=1
ReadOnly=1
InstancesMax=2
