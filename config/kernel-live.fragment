# config/kernel-live.fragment — options noyau pour le système live YAOR (jalons 0.1–0.2).
#
# Ce fragment est fusionné par scripts/kconfig/merge_config.sh sur un
# `make defconfig` (x86_64_defconfig). Il ne liste donc que les options que
# l'on veut FORCER : le reste vient de la configuration par défaut, réputée
# raisonnable et maintenue.
#
# Objectif : pouvoir démarrer sur une image EROFS (compressée) posée en
# overlayfs sur tmpfs, puis lancer systemd comme PID 1, y compris sous QEMU.

# --- Compression du noyau (ADR-011 : zstd) ---
# Le defconfig compresse le noyau en gzip ; on force zstd, plus rapide à
# décompresser au démarrage et légèrement plus compact.
CONFIG_KERNEL_ZSTD=y

# --- Système de fichiers racine du live (ADR-011) ---
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Amorçage : devtmpfs, initramfs ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

# --- Démarrage BIOS + UEFI (Limine) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- Stockage : loop pour EROFS, disques et images ---
CONFIG_BLK_DEV_LOOP=y
CONFIG_ISO9660_FS=y

# --- Systèmes de fichiers supportés (ADR-015, REQ-SW-025) ---
# ext4 (racine par défaut), btrfs, vfat + exFAT (volumes amovibles) et NTFS en
# lecture/écriture via ntfs3. Le NTFS historique en lecture seule (ntfs-3g) est
# écarté : ntfs3 est le fournisseur unique (un besoin, un fournisseur).
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
# CONFIG_NTFS_FS is not set
# Jeux de caractères requis par vfat (noms de fichiers longs).
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# --- Virtualisation (QEMU : cible de test) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# --- Console / affichage (framebuffer console pour VGA/EFI) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y

# --- Exigences de systemd (PID 1) ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_FHANDLE=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_SECCOMP=y
CONFIG_KEYS=y

# --- Modules : pas de signature ni de BTF (évite openssl/pahole à la compilation) ---
CONFIG_MODULES=y
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO_BTF=n
# Aucune infrastructure de clés ni de signature n'est embarquée (ADR-020).
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_SYSTEM_REVOCATION_LIST is not set
# Les avertissements du compilateur restent des avertissements.
# CONFIG_WERROR is not set

# --- Chargement des microprogrammes (Wi-Fi, ADR-013) ---
# linux-firmware distribue des microprogrammes compressés (.xz/.zst).
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# --- Réseau sans fil (ADR-013, ADR-020) ---
# La vérification *par signature* de la base réglementaire est désactivée sans
# introduire OpenSSL : REQUIRE_SIGNED_REGDB n'a d'invite de configuration que si
# CERTIFICATION_ONUS est actif, d'où son activation préalable. On évite ainsi
# SYSTEM_TRUSTED_KEYRING (donc OpenSSL) tout en gardant le Wi-Fi (ADR-020).
CONFIG_CFG80211=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_MAC80211=y
CONFIG_WLAN=y
# Pilotes courants en modules : udev les charge selon le matériel présent.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH11K=m
CONFIG_ATH12K=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2E=m
CONFIG_MT7915E=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7996E=m
CONFIG_BRCMFMAC=m
CONFIG_RTL8XXXU=m

# --- Audio QEMU (ADR-024, TEST-AUD-001) --------------------------------------
# Le pont audio minimal de QEMU (intel-hda) exige le pilote de codec
# générique : sans lui, la carte HDA n'est pas attachée et PipeWire ne
# livre qu'un sink null (aucun son réellement rendu).
CONFIG_SND_HDA_GENERIC=y
